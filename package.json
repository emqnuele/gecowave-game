{
  "name": "gecowave-flux-of-coscience",
  "private": true,
  "version": "1.1.2",
  "description": "action-platformer 2D ambientato nel GecoRealm, sviluppato per gecowave",
  "author": "emqnuele (https://emanuelefaraci.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emqnuele/gecowave-game.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "regions": "scripts/world/run.sh build-regions",
    "electron": "electron .",
    "gen-icons": "node scripts/assets/gen-icons.mjs",
    "app:preview": "npm run build && electron .",
    "app:build": "npm run gen-icons && npm run build && electron-builder"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "^1.0.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "playwright-core": "^1.63.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.1",
    "source-map-js": "^1.2.2",
    "typescript": "~5.9.3",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/climate-crisis": "^5.2.12",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/martian-mono": "^5.2.7",
    "@fontsource/permanent-marker": "^5.2.7",
    "peerjs": "1.5.5",
    "phaser": "^3.90.0"
  },
  "build": {
    "appId": "com.gecowave.flux",
    "productName": "GECOWAVE - The Flux of Coscience",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "GECOWAVE - The Flux of Coscience",
      "artifactName": "GECOWAVE-${version}.${ext}",
      "icon": "build/icon.icns",
      "iconSize": 120,
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 360
      },
      "contents": [
        {
          "x": 140,
          "y": 170,
          "type": "file"
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GECOWAVE - The Flux of Coscience",
      "artifactName": "GECOWAVE-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png"
    }
  }
}
